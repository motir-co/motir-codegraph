{
  "name": "motir-codegraph",
  "version": "0.0.0",
  "private": true,
  "description": "Motir's code graph service: a standalone, multi-tenant code index on its own Postgres.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx src/cli/bootstrap.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "operator:bootstrap": "node --env-file-if-exists=.env --import tsx src/cli/bootstrap-operator.ts",
    "serve": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-dart-orchard": "0.7.1",
    "tree-sitter-elixir": "0.3.5",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-haskell": "0.23.1",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-scala": "0.24.0",
    "tree-sitter-solidity": "1.2.13",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
