# motir-codegraph runs on its own Postgres and needs no Motir service.
# Copy this file to .env. Every URL points at a local Postgres (16 or later);
# nothing here names a Motir host or holds a real secret.

# A SUPERUSER, used ONLY by `pnpm db:bootstrap`, locally and in CI, to create
# the two logins below and their database. Production never sets it: the data
# stack's role bootstrap creates the logins there.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The OWNER login, codegraph_owner: owns every table and is the only login
# migrations run as. The tests connect with it too. `db:bootstrap` sets its
# password from this URL.
DATABASE_URL=postgresql://codegraph_owner:codegraph_owner@localhost:5432/codegraph

# The APPLICATION login, codegraph_app: the login the service runs as. It owns
# nothing, cannot run DDL, and is held to its tenant by row-level security.
# `db:bootstrap` sets its password from this URL. The HTTP server (`pnpm serve`)
# connects with this URL and no other.
DATABASE_APP_URL=postgresql://codegraph_app:codegraph_app@localhost:5432/codegraph

# The port the HTTP server listens on. Not a database setting, so the server
# defaults to 8080 when it is unset. HOST defaults to 0.0.0.0.
PORT=8080

# The requests one caller (one credential) may make to /v1 per minute, on one
# copy of the server. Over it, a call is refused 429 rate_limited before any
# database work. Defaults to 1200 when it is unset. A caller that sends a new
# made-up credential each time is a new caller to this limit: the next one
# stops it.
RATE_LIMIT_PER_MINUTE=1200

# The sign-in attempts one client address may make to /v1 per minute, on one
# copy, with a credential that has not authenticated on that copy in the last
# minute (in practice its failures). Over it, a call from that address is
# refused 429 rate_limited before any database work. A credential that has
# authenticated passes uncounted. Defaults to 60 when it is unset.
FAILED_AUTH_LIMIT_PER_MINUTE=60

# The largest file, in bytes, the store indexes or keeps contents for. A file
# over it is stored as refused, recording its size and this cap, with no
# contents and no facts. Defaults to 1048576 (1 MiB) when it is unset.
PER_FILE_CAP_BYTES=1048576

# The proxies in front of the server (comma-separated addresses and CIDR
# ranges, e.g. the load balancer's subnets) whose X-Forwarded-For is believed,
# so the limit above counts the real client address. Unset trusts none: behind
# a load balancer every caller then shares its address.
TRUST_PROXY=

# The commit-layer library's three knobs. Service configuration, the same for
# every tenant and repository; never per-tenant settings. Read once at start-up:
# a bad value, or a threshold not below the ceiling minus one, stops the process.
#
# The layer depth past which a published layer is compacted into a new base
# (a whole number of layers). Defaults to 8 when it is unset.
COMPACTION_THRESHOLD=8

# The layer depth at which a commit is written as a base rather than a deeper
# delta, so no chain is ever longer (a whole number of layers). Defaults to 32
# when it is unset.
HARD_CEILING=32

# How long a staged layer may sit before it is discarded as left by a dead job,
# releasing the blobs it pinned, in milliseconds. Longer than any index job.
# Defaults to 7200000 (two hours) when it is unset.
STAGED_LAYER_STALENESS_MS=7200000

# The fetcher's four settings (src/fetch). Service configuration, the same for
# every tenant and repository; never per-tenant settings. A bad value stops the
# process that reads it, naming the variable.
#
# The largest source archive a fetch downloads, in bytes, whether the server
# declares its length or streams past it. Defaults to 268435456 (256 MiB) when
# it is unset — above a motir-core-sized repository's archive.
FETCH_BYTE_CAP_BYTES=268435456

# The most bytes an archive's regular files may extract to. Defaults to
# 1073741824 (1 GiB) when it is unset.
TAR_BYTE_CAP_BYTES=1073741824

# How long one whole fetch may take, in milliseconds: every redirect, the
# download, the extraction and the hash. Defaults to 120000 (two minutes) when
# it is unset — well inside the ten-minute first-index target.
FETCH_TIMEOUT_MS=120000

# Source hosts (comma-separated bare host names, no scheme, port, path or
# wildcard) that may resolve to a loopback or private address, e.g. a source
# host inside the deployment's own network. Unset allows none. Even a listed
# host is never fetched from a link-local or instance-metadata address.
FETCH_ALLOWED_HOSTS=

# The indexer worker (`pnpm worker`, `pnpm start:worker`). Every setting below
# is service configuration, the same for every tenant and repository; none is
# per tenant. The worker connects with DATABASE_APP_URL only.

# The directory the worker writes each job's source under, one directory per
# job, deleted when the job ends. Required: it must exist and be writable.
SCRATCH_DIR=/tmp/codegraph-worker

# How long an idle worker waits before it claims again, in milliseconds.
# Defaults to 1000 when it is unset.
WORKER_POLL_MS=1000

# How long a claimed job's lease runs from each renewal, in milliseconds. A job
# whose lease lapses returns to the queue. Defaults to 300000 (five minutes).
JOB_LEASE_MS=300000

# How many claims a job may have before it ends failed with
# attempts_exhausted. Defaults to 3.
MAX_ATTEMPTS=3

# How many missing blobs one worker run stores itself. A job missing more is
# split into batches of at most this many, which any worker may claim, and
# published once after its last batch is stored. Defaults to 500.
BLOB_STORE_BATCH_SIZE=500

# The worker's maintenance tick: after it runs a job, the worker checks that
# job's repository for a staged layer older than STAGED_LAYER_STALENESS_MS and
# for layers it can release, and enqueues a discard_stale or release job for
# each it finds (compaction is enqueued by the publish itself). The least time
# between two ticks of one repository, in milliseconds. Defaults to 60000.
MAINTENANCE_INTERVAL_MS=60000

# The most maintenance jobs one tick enqueues. Defaults to 3.
MAINTENANCE_JOBS_PER_TICK=3

# The worker's queue metrics: every METRICS_INTERVAL_MS the worker writes one
# CloudWatch embedded-metric-format line to stdout (namespace
# Codegraph/IndexQueue: QueuedJobs, QueuedBatches, OldestQueuedJobAgeSeconds,
# FailedJobsRecent). Both are service configuration, never per tenant.
# Milliseconds between two samples. Defaults to 30000.
METRICS_INTERVAL_MS=30000

# How far back FailedJobsRecent counts failed jobs, in milliseconds. Defaults
# to 300000 (five minutes).
FAILED_JOBS_WINDOW_MS=300000
