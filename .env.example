# motir-codegraph runs on its own Postgres and needs no Motir service.
# Copy this file to .env and adjust the passwords. Every URL points at a local
# Postgres (16 or later); nothing here names a Motir host or holds a secret.
#
# The two logins below are created by the migrations card (`codegraph_owner`
# and `codegraph_app`); until then DATABASE_URL may point at any local role.

# The OWNER login, codegraph_owner: owns every table and is the only login
# migrations run as. The tests connect with it too.
DATABASE_URL=postgresql://codegraph_owner:codegraph_owner@localhost:5432/codegraph

# The APPLICATION login, codegraph_app: the login the service runs as. It owns
# nothing and is held to its tenant by row-level security.
DATABASE_APP_URL=postgresql://codegraph_app:codegraph_app@localhost:5432/codegraph
